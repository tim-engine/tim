  "homepage": "https://openpeeps.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpeeps/tim.git"
  },
  "bugs": {
    "url": "https://github.com/openpeeps/tim/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ]
