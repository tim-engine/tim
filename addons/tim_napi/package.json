{
  "name": "@openpeeps/tim",
  "version": "0.2.10",
  "description": "Node.js native bindings for Tim Engine — a super fast template engine written in Nim",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "scripts/place-binary.js",
